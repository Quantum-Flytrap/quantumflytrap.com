---
import type { Mention } from "../data/mentions";

interface Props {
  item: Mention;
  focusable?: boolean;
}

const { item, focusable = true } = Astro.props;
const name = item.quotedBy ?? item.authors;
---

{name && <><span class="attribution-name">{name}</span>, </>}<a href={item.url} tabindex={focusable ? undefined : "-1"}>{item.venue ?? item.title}</a>{item.year && `, ${item.year}`}{item.note && ` (${item.note})`}
