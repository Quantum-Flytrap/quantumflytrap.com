---
import SiteLayout from "../layouts/SiteLayout.astro";

const experiments = [
  ["Mach–Zehnder", "mach-zehnder"],
  ["Bell inequality", "bell-inequality"],
  ["Quantum teleportation", "quantum-teleportation?mode=waves"],
  ["Ekert protocol", "ekert-protocol?mode=waves"],
  ["Deutsch–Jozsa", "deutsch-jozsa"],
  ["Three polarizers", "three-polarizer-paradox"],
];
---

<SiteLayout>
  <section class="hero-simple">
    <div>
      <p class="eyebrow">Quantum Flytrap</p>
      <h1>Virtual Lab</h1>
      <p class="lead">A free, browser-based optical table for exploring quantum mechanics. Build experiments, run the simulation, and inspect quantum states and measurements.</p>
      <div class="actions">
        <a class="button button--primary" href="https://lab.quantumflytrap.com/lab/">Open Virtual Lab</a>
        <a class="button" href="https://lab.quantumflytrap.com/game/level/the-beginning">Start Quantum Game</a>
      </div>
    </div>
    <div>
      <a class="plain-image" href="https://lab.quantumflytrap.com/lab/mach-zehnder">
        <img src="/assets/virtual-lab-preview.png" alt="Virtual Lab showing a quantum optical experiment" />
      </a>
      <a class="image-link" href="https://lab.quantumflytrap.com/lab/mach-zehnder">Open this experiment →</a>
    </div>
  </section>

  <p class="project-status"><strong>Virtual Lab is active and supported.</strong> The Quantum Flytrap startup closed in 2022. The Lab is owned and supported by Piotr Migdał and Klem Jankiewicz and will remain online indefinitely.</p>

  <section class="content-section">
    <h2>Projects</h2>
    <div class="project-grid">
      <article class="project-card">
        <a class="plain-image" href="https://lab.quantumflytrap.com/lab/">
          <img src="/assets/virtual-lab-preview.png" alt="Virtual Lab experiment" />
        </a>
        <div>
          <h3>Virtual Lab</h3>
          <p>An open sandbox for interference, entanglement, quantum gates, cryptography, and measurement. Free to use in classes; screenshots are available under CC BY.</p>
          <a class="text-link" href="https://lab.quantumflytrap.com/lab/">Open Virtual Lab →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image" href="https://lab.quantumflytrap.com/game/level/the-beginning">
          <img src="/assets/quantum-game-level.png" alt="The first level of Quantum Game" />
        </a>
        <div>
          <h3>Quantum Game</h3>
          <p>Guided puzzles introducing photons, superposition, interference, polarization, and measurement.</p>
          <a class="text-link" href="https://lab.quantumflytrap.com/game/level/the-beginning">Play Quantum Game →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image" href="https://github.com/Quantum-Game/bra-ket-vue">
          <img src="/assets/cnot-gate.png" alt="A CNOT operator visualized with BraKetVue" />
        </a>
        <div>
          <h3>BraKetVue</h3>
          <p>Open-source components for visualizing quantum states and operators.</p>
          <a class="text-link" href="https://github.com/Quantum-Game/bra-ket-vue">BraKetVue on GitHub →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image" href="https://github.com/Quantum-Game/quantum-tensors">
          <img src="/blog/virtual-lab-updates-oct-2022/virtual-lab-interface-redesign.png" alt="Quantum-state and measurement views powered by Quantum Tensors" />
        </a>
        <div>
          <h3>Quantum Tensors</h3>
          <p>TypeScript numerics for multipartite quantum systems in the browser.</p>
          <a class="text-link" href="https://github.com/Quantum-Game/quantum-tensors">Quantum Tensors on GitHub →</a>
        </div>
      </article>
    </div>
  </section>

  <section class="content-section content-section--tinted">
    <h2>Experiments</h2>
    <div class="link-grid">
      {experiments.map(([name, slug]) => (
        <a href={`https://lab.quantumflytrap.com/lab/${slug}`}>{name}<span>→</span></a>
      ))}
    </div>
  </section>

  <section class="content-section">
    <div class="section-title">
      <h2>Publications</h2>
      <a href="/research/">Details and citing works →</a>
    </div>
    <div class="paper-list">
      <article>
        <div>
          <h3>Visualizing quantum mechanics in an interactive simulation—Virtual Lab by Quantum Flytrap</h3>
          <p>P. Migdał, K. Jankiewicz, P. Grabarz, C. Decaroli, P. Cochin · <cite>Optical Engineering</cite> · 2022</p>
          <a href="https://doi.org/10.1117/1.OE.61.8.081808">DOI</a> · <a href="https://arxiv.org/abs/2203.13300">arXiv</a>
        </div>
        <strong>33 citations</strong>
      </article>
      <article>
        <div>
          <h3>Quantum games and interactive tools for quantum technologies outreach and education</h3>
          <p>Z. C. Seskir, P. Migdał, C. Weidner, et al. · <cite>Optical Engineering</cite> · 2022</p>
          <a href="https://doi.org/10.1117/1.OE.61.8.081809">DOI</a> · <a href="https://arxiv.org/abs/2202.07756">arXiv</a>
        </div>
        <strong>83 citations</strong>
      </article>
    </div>
    <p class="source-note">Citation counts: Crossref, 23 July 2026. Virtual Lab has been used in quantum information courses at Oxford and Stanford and is available in eight languages.</p>
  </section>
</SiteLayout>
