---
import SiteLayout from "../layouts/SiteLayout.astro";
import Attribution from "../components/Attribution.astro";
import { featuredMentions } from "../data/mentions";

const experiments = [
  {
    name: "Mach–Zehnder",
    url: "https://lab.quantumflytrap.com/lab/mach-zehnder",
    image: "/assets/experiment-mach-zehnder.png",
    alt: "Mach–Zehnder interferometer in Virtual Lab",
  },
  {
    name: "Bell inequality",
    url: "https://lab.quantumflytrap.com/lab/bell-inequality",
    image: "/assets/experiment-bell.png",
    alt: "Bell inequality experiment in Virtual Lab",
  },
  {
    name: "Quantum teleportation",
    url: "https://lab.quantumflytrap.com/lab/quantum-teleportation?mode=waves",
    image: "/assets/experiment-teleportation.png",
    alt: "Quantum teleportation experiment in Virtual Lab",
  },
  {
    name: "Deutsch–Jozsa",
    url: "https://lab.quantumflytrap.com/lab/deutsch-jozsa",
    image: "/assets/experiment-deutsch-jozsa.png",
    alt: "Deutsch–Jozsa algorithm experiment in Virtual Lab",
  },
];

---

<SiteLayout>
  <section class="hero-simple">
    <div>
      <h1>Virtual Lab</h1>
      <p class="lead">A free, browser-based optical table for exploring quantum mechanics. Build experiments, run the simulation, and inspect quantum states and measurements.</p>
      <div class="actions">
        <a class="button button--primary" href="https://lab.quantumflytrap.com/lab/">Start experimenting</a>
      </div>
      <p class="project-status"><strong>Virtual Lab is active</strong> and independently maintained by its creators, Piotr Migdał and Klem Jankiewicz.</p>
    </div>
    <div class="experiment-carousel">
      <a id="featured-experiment-link" class="plain-image hero-experiment" href={experiments[0].url}>
        {experiments.map((experiment, index) => (
          <img
            class:list={{ "is-active": index === 0 }}
            src={experiment.image}
            alt={experiment.alt}
            aria-hidden={index === 0 ? undefined : "true"}
            loading={index === 0 ? undefined : "lazy"}
          />
        ))}
      </a>
      <div class="carousel-controls" aria-label="Featured Virtual Lab experiment">
        {experiments.map((experiment, index) => (
          <button
            class:list={{ "carousel-control": true, "is-active": index === 0 }}
            type="button"
            data-name={experiment.name}
            data-url={experiment.url}
            aria-label={experiment.name}
            aria-pressed={index === 0 ? "true" : "false"}
          ></button>
        ))}
      </div>
      <div class="carousel-caption">
        <span id="featured-experiment-title" class="carousel-title">{experiments[0].name}</span>
        <a id="featured-experiment-name" class="image-link" href={experiments[0].url}>Go to this experiment →</a>
      </div>
    </div>
  </section>

  <section id="educators" class="content-section educators">
    <div>
      <h2>Teaching with Virtual Lab</h2>
      <div class="educators-body">
        <p>Virtual Lab is used in lectures, lab classes, and outreach events all over the world. If you use it in your teaching, we'd love to know where you teach, how you use it, and what would make it more useful for your students. This helps us decide what to work on next.</p>
        <img class="educators-wave" src="/assets/quantum-flytrap-wave.png" alt="" width="285" height="130" />
      </div>
      <div class="actions">
        <a class="button button--primary" href="mailto:contact@quantumflytrap.com">Tell us how you use it</a>
        <a class="button" href="/mentions/#teaching">How others use it</a>
      </div>
    </div>
  </section>

  <section id="testimonials" class="content-section testimonials">
    <div class="section-title">
      <h2>Testimonials</h2>
      <a class="text-link" href="/mentions/#quotes">More testimonials →</a>
    </div>
    <div class="carousel-controls testimonial-controls" style={`--count: ${featuredMentions.length}`} aria-label="Quotes about Virtual Lab">
      {featuredMentions.map((mention, index) => (
        <button
          class:list={{ "testimonial-control": true, "is-active": index === 0 }}
          type="button"
          aria-label={`Quote by ${mention.quotedBy ?? mention.authors ?? mention.venue}`}
          aria-pressed={index === 0 ? "true" : "false"}
        ></button>
      ))}
    </div>
    <div class="testimonial-carousel">
      {featuredMentions.map((mention, index) => (
        <figure class:list={{ testimonial: true, "is-active": index === 0 }} aria-hidden={index === 0 ? undefined : "true"}>
          <blockquote>“{mention.quote}”</blockquote>
          <figcaption><Attribution item={mention} focusable={index === 0} /></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="content-section">
    <h2>Other work</h2>
    <div class="project-grid">
      <article class="project-card">
        <a class="plain-image" href="https://quantumgame.io/">
          <img src="/assets/quantum-game.svg" alt="Quantum Game artwork" />
        </a>
        <div>
          <h3>Quantum Game</h3>
          <p>Guided puzzles introducing photons, superposition, interference, polarization, and measurement.</p>
          <a class="text-link" href="https://quantumgame.io/">Quantum Game →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image crop-top" href="https://github.com/Quantum-Flytrap/bra-ket-vue">
          <img src="/assets/cnot-gate.png" alt="A CNOT operator visualized with BraKetVue" />
        </a>
        <div>
          <h3>BraKetVue</h3>
          <p>Open-source components for visualizing quantum states and operators.</p>
          <a class="text-link" href="https://github.com/Quantum-Flytrap/bra-ket-vue">BraKetVue on GitHub →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image" href="https://github.com/Quantum-Flytrap/quantum-tensors">
          <img src="/assets/quantum-tensors-logo.jpg" alt="Quantum Tensors" />
        </a>
        <div>
          <h3>Quantum Tensors</h3>
          <p>TypeScript numerics for multipartite quantum systems in the browser.</p>
          <a class="text-link" href="https://github.com/Quantum-Flytrap/quantum-tensors">Quantum Tensors on GitHub →</a>
        </div>
      </article>

      <article class="project-card">
        <a class="plain-image" href="https://pulserstudio.pasqal.cloud/">
          <img src="/assets/pulser-studio.png" alt="Pulser Studio interface" />
        </a>
        <div>
          <h3>Pulser Studio</h3>
          <p>A visual editor for neutral-atom pulse sequences, developed by Quantum Flytrap for Pasqal.</p>
          <a class="text-link" href="https://pulserstudio.pasqal.cloud/">Open Pulser Studio →</a>
        </div>
      </article>
    </div>
  </section>

  <section id="publications" class="content-section content-section--tinted">
    <div class="section-title">
      <h2>Publications</h2>
    </div>
    <div class="publication-grid">
      <article class="publication-card">
        <h3>Visualizing quantum mechanics in an interactive simulation—Virtual Lab by Quantum Flytrap</h3>
        <p>P. Migdał, K. Jankiewicz, P. Grabarz, C. Decaroli, P. Cochin · Optical Engineering · 2022</p>
        <div class="publication-links">
          <span><a href="https://doi.org/10.1117/1.OE.61.8.081808">DOI</a> · <a href="https://arxiv.org/abs/2203.13300">arXiv</a></span>
          <strong>33 citations</strong>
        </div>
      </article>
      <article class="publication-card">
        <h3>Quantum games and interactive tools for quantum technologies outreach and education</h3>
        <p>Z. C. Seskir, P. Migdał, C. Weidner, et al. · Optical Engineering · 2022</p>
        <div class="publication-links">
          <span><a href="https://doi.org/10.1117/1.OE.61.8.081809">DOI</a> · <a href="https://arxiv.org/abs/2202.07756">arXiv</a></span>
          <strong>83 citations</strong>
        </div>
      </article>
    </div>
    <div class="actions">
      <a class="button" href="/mentions/#research">How these papers are cited and used</a>
    </div>
  </section>

  <section class="content-section">
    <h2>About Virtual Lab by Quantum Flytrap</h2>
    <div class="about-intro">
      <div>
        <p>Virtual Lab is an online, no-code environment for exploring quantum phenomena. It simulates up to four entangled photons in real time, including state evolution, entanglement, measurement, the Deutsch–Jozsa algorithm, and the Ekert quantum cryptography protocol.</p>
        <p>Its drag-and-drop optical table includes photon sources, beam splitters, gates, and detectors. It is designed for use by learners, educators, and researchers.</p>
      </div>
      <svg id="rock" class="about-rock" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true" focusable="false"><g><path fill="#44375E" d="M10.15 55.324L2.697 42.645a3.084 3.084 0 01-.605-2.695l6.043-20.765C10.05 12.595 16.092 10 23.042 10l14.503.899c1.712 0 3.223.698 4.532 1.697l14.604 11.98a6.79 6.79 0 012.518 4.093l3.324 14.775c0 .699 0 1.298-.302 1.997l-3.928 9.484c-.504.998-1.612 1.697-2.82 1.697H12.768c-1.007 0-2.014-.4-2.618-1.298z" class="base"></path><path fill="#615777" d="M43.108 13.441c-6.835-.705-19.915-1.6-23.003.87-4.443 3.4-7.701 23.867-7.701 25.803 0 1.466 2.666 11.142 3.85 14.367h-6.6L2.697 42.645a3.084 3.084 0 01-.605-2.695l6.043-20.765C10.05 12.595 16.092 10 23.042 10l14.503.899c1.712 0 3.223.698 4.532 1.697l1.03.845z" class="light"></path><path fill="#2F2549" d="M43.256 13.563l13.425 11.013a6.79 6.79 0 012.518 4.093l3.324 14.775c0 .699 0 1.298-.302 1.997l-3.928 9.484c-.504.998-1.612 1.697-2.82 1.697h-.13l-27.623-2.14s17.478-2.141 21.139-2.64c5.019-.88 6.79-3.811 6.495-6.45 0-2.053 0-7.038-2.067-9.09-1.346-1.319-3.332-1.541-5.966-1.837-1.408-.158-3-.336-4.78-.714-5.02-1.173-7.381-11.143-6.2-13.195.435-1.08 4.23-4.543 6.791-6.88l.124-.113z" class="dark"></path><path fill="#120223" d="M9.654 54.481l.496.843c.604.898 1.611 1.298 2.618 1.298h42.705c1.208 0 2.316-.699 2.82-1.697l.183-.444H9.654z" class="shadow"></path><g class="eyes"><path fill="#fff" d="M26.096 29.265c0 3.643-2.974 6.597-6.642 6.597-3.67 0-6.643-2.954-6.643-6.598 0-3.643 2.974-6.597 6.643-6.597 3.668 0 6.642 2.954 6.642 6.598zm18.895 0c0 3.643-2.974 6.597-6.642 6.597-3.67 0-6.643-2.954-6.643-6.598 0-3.643 2.974-6.597 6.643-6.597 3.668 0 6.642 2.954 6.642 6.598z" class="white"></path><path fill="#120223" d="M22.79 29.265c0 1.83-1.494 3.313-3.336 3.313-1.843 0-3.337-1.484-3.337-3.314s1.494-3.313 3.337-3.313c1.842 0 3.336 1.484 3.336 3.314zm18.895 0c0 1.83-1.494 3.313-3.336 3.313-1.843 0-3.336-1.484-3.336-3.314s1.493-3.313 3.336-3.313c1.842 0 3.336 1.484 3.336 3.314z" class="iris"></path><path fill="#5C00D3" d="M20.753 29.265c0 .712-.582 1.29-1.3 1.29a1.295 1.295 0 01-1.298-1.29c0-.713.581-1.29 1.299-1.29.717 0 1.299.577 1.299 1.29zm18.895 0c0 .712-.582 1.29-1.3 1.29-.717 0-1.298-.578-1.298-1.29 0-.713.581-1.29 1.299-1.29.717 0 1.299.577 1.299 1.29z" class="pupil"></path><g class="eyelids"><mask id="rock-eyelid-mask" width="34" height="15" x="12" y="14" class="mask0" maskUnits="userSpaceOnUse"><path fill="#fff" d="M12.629 14.985h32.475v13.781H12.63V14.985z" class="eyelid-mask"></path></mask><g mask="url(#rock-eyelid-mask)"><path fill="#615777" d="M26.21 29.352c0 3.725-3.04 6.744-6.791 6.744-3.75 0-6.79-3.019-6.79-6.743 0-3.725 3.04-6.745 6.79-6.745s6.79 3.02 6.79 6.744zm18.894 0c0 3.725-3.04 6.744-6.79 6.744s-6.79-3.019-6.79-6.743c0-3.725 3.04-6.745 6.79-6.745s6.79 3.02 6.79 6.744z" class="eyelids_2" clip-rule="evenodd"></path></g></g></g></g></svg>
    </div>
    <div class="about-summary">
      <div>
        <h3>Team</h3>
        <p>The project is led by <a href="https://jankiewiczstudio.com/">Klem Jankiewicz</a> (design), <a href="https://p.migdal.pl/">Piotr Migdał</a> (quantum physics), and <a href="https://github.com/frizi">Paweł Grabarz</a> (software development). Contributors include Agata Rakowiecka, Bijaya Dangol, Chiara Decaroli, Kamila Stępniowska, and Alicja Głuszek. Artur Ekert served as an advisor.</p>
      </div>
      <div>
        <h3>Use and funding</h3>
        <p>Virtual Lab has been used in quantum information courses at the University of Oxford and Stanford University, as well as educational events and hackathons. Earlier development was funded by the Centre for Quantum Technologies at the National University of Singapore and the Unitary Fund.</p>
      </div>
      <div>
        <h3>Usage rights and languages</h3>
        <p>Virtual Lab is free to use in lectures and classes and will remain so. Experiment screenshots may be reused under the CC BY license in slides, textbooks, publications, and other materials.</p>
        <p>It is available in English, Spanish, Polish, Portuguese, French, German, Ukrainian, and Chinese.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="content-section">
    <h2>Contact</h2>
    <p>Email <a href="mailto:contact@quantumflytrap.com">contact@quantumflytrap.com</a>, or contact <a href="mailto:piotr@quantumflytrap.com">Piotr</a> or <a href="mailto:klem@quantumflytrap.com">Klem</a> directly.</p>
  </section>

  <script>
    const controls = [...document.querySelectorAll<HTMLButtonElement>(".carousel-control")];
    const images = [...document.querySelectorAll<HTMLImageElement>("#featured-experiment-link img")];
    const imageLink = document.querySelector<HTMLAnchorElement>("#featured-experiment-link");
    const nameLink = document.querySelector<HTMLAnchorElement>("#featured-experiment-name");
    const title = document.querySelector<HTMLElement>("#featured-experiment-title");

    const showExperiment = (index: number) => {
      const { name, url } = controls[index].dataset;
      if (!name || !url || !imageLink || !nameLink || !title) return;
      imageLink.href = url;
      nameLink.href = url;
      title.textContent = name;
      images.forEach((image, i) => {
        image.classList.toggle("is-active", i === index);
        image.toggleAttribute("aria-hidden", i !== index);
      });
      controls.forEach((control, i) => {
        control.classList.toggle("is-active", i === index);
        control.setAttribute("aria-pressed", String(i === index));
      });
    };

    controls.forEach((control, index) => {
      control.addEventListener("click", () => showExperiment(index));
      // The progress bar animation drives the rotation; it is off for reduced motion.
      control.addEventListener("animationend", () => showExperiment((index + 1) % controls.length));
    });

    const quotes = [...document.querySelectorAll<HTMLElement>(".testimonial")];
    const quoteArea = document.querySelector<HTMLElement>(".testimonials");
    const quoteControls = [...document.querySelectorAll<HTMLButtonElement>(".testimonial-control")];

    const showQuote = (index: number) => {
      quotes.forEach((quote, i) => {
        const active = i === index;
        quote.classList.toggle("is-active", active);
        quote.toggleAttribute("aria-hidden", !active);
        const link = quote.querySelector("a");
        if (active) link?.removeAttribute("tabindex");
        else link?.setAttribute("tabindex", "-1");
      });
      quoteControls.forEach((control, i) => {
        control.classList.toggle("is-active", i === index);
        control.setAttribute("aria-pressed", String(i === index));
      });
    };

    // Rotate only while the quotes are on screen.
    if (quoteArea) {
      new IntersectionObserver(([entry]) => quoteArea.classList.toggle("is-offscreen", !entry.isIntersecting)).observe(quoteArea);
    }

    quoteControls.forEach((control, index) => {
      control.addEventListener("click", () => showQuote(index));
      // As with the experiments, the progress bar drives the rotation; hovering the quotes pauses it.
      control.addEventListener("animationend", () => showQuote((index + 1) % quoteControls.length));
    });

    // The rock's eyes follow the pointer, as in Virtual Lab; without pointer movement they glance around.
    const rock = document.querySelector<SVGSVGElement>("#rock");
    if (rock) {
      let idleTimer = 0;
      const look = (x: number, y: number) => {
        const length = Math.hypot(x, y);
        const scale = length > 1 ? 1 / length : 1;
        rock.style.setProperty("--eye-x", String(x * scale));
        rock.style.setProperty("--eye-y", String(y * scale));
      };
      const glance = () => {
        const away = Math.random() > .5;
        look(away ? Math.random() - .5 : 0, away ? Math.random() - .5 : 0);
        idleTimer = window.setTimeout(glance, away ? 600 + Math.random() * 1200 : 2000 + Math.random() * 1000);
      };
      window.addEventListener("pointermove", (event) => {
        window.clearTimeout(idleTimer);
        const box = rock.getBoundingClientRect();
        look(((event.clientX - box.x) / box.width - .5) * 10, ((event.clientY - box.y) / box.height - .45) * 10);
        idleTimer = window.setTimeout(glance, 4000);
      });
      glance();
    }
  </script>
</SiteLayout>
