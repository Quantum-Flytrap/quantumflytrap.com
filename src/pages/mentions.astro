---
import Attribution from "../components/Attribution.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { mentionGroups } from "../data/mentions";

const quotes = mentionGroups
  .flatMap((group) => group.items)
  .filter((item) => item.quote)
  .sort((a, b) => (a.featured ?? Infinity) - (b.featured ?? Infinity));
---

<SiteLayout title="Mentions" description="Courses, research papers, and press that use or discuss Virtual Lab by Quantum Flytrap.">
  <header class="page-hero">
    <p class="eyebrow">Mentions</p>
    <h1>Virtual Lab in the wild</h1>
    <p class="lead">Courses, research papers, and press that use or discuss Virtual Lab and the Quantum Game.</p>
  </header>

  <section class="content-section">
    <h2 id="quotes">What people say</h2>
    <div class="quote-grid">
      {quotes.map((item) => (
        <figure class="quote">
          <blockquote>“{item.quote}”</blockquote>
          <figcaption><Attribution item={item} /></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="content-section mention-groups">
    {mentionGroups.map((group) => (
      <>
        <h2 id={group.id}>{group.title}</h2>
        <ul class="mention-list">
          {group.items.map((item, index) => {
            const excerptId = item.excerpt ? `${group.id}-${index}` : undefined;
            const details = [item.authors, item.venue, item.year].filter(Boolean).join(", ");
            return (
              <li>
                <a href={item.url} aria-describedby={excerptId}>{item.title}</a>{details && <span class="mention-by">. {details}</span>}
                {item.excerpt && <span class="mention-excerpt" id={excerptId} role="tooltip">{item.excerpt}</span>}
              </li>
            );
          })}
        </ul>
      </>
    ))}
    <p class="meta">Using Virtual Lab in your course, paper, or event? Let us know at <a href="mailto:contact@quantumflytrap.com">contact@quantumflytrap.com</a>.</p>
  </section>
</SiteLayout>
