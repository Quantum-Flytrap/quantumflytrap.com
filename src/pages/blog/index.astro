---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<SiteLayout title="Archive">
  <header class="page-hero"><p class="eyebrow">Archive</p><h1>Notes from Quantum Flytrap.</h1></header>
  <section class="prose">
    <div class="project-list">
      {posts.map((post) => (
        <a class="project-row" href={`/blog/${post.data.slug}/`}>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span>{post.data.date.toLocaleDateString("en-GB", { year: "numeric", month: "short" })}</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
