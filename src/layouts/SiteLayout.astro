---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Quantum Flytrap",
  description = "Virtual Lab is a free, browser-based optical table for learning and teaching quantum physics.",
} = Astro.props;
const pageTitle = title === "Quantum Flytrap" ? title : `${title} · Quantum Flytrap`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#150e26" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@500;600;700&display=swap" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/assets/virtual-lab-preview.png", Astro.site)} />
    <script is:inline defer data-domain="quantumflytrap.com" src="https://plausible.io/js/script.js"></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Quantum Flytrap home">
        <img src="/assets/quantum-flytrap-logo-horizontal.png" alt="Quantum Flytrap" width="712" height="130" />
      </a>
      <nav aria-label="Main navigation">
        <a href="/#publications">Publications</a>
        <a href="/mentions/">Mentions</a>
        <a href="/#contact">Contact</a>
        <a href="https://quantumgame.io/">Quantum Game</a>
        <a class="nav-cta" href="https://lab.quantumflytrap.com/">Virtual Lab</a>
      </nav>
    </header>
    <main id="content">
      <slot />
    </main>
  </body>
</html>
